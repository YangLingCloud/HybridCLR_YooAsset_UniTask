<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="HybridBuilderWindow.uss" />

    <ui:VisualElement name="BuildContainer" class="root-container">

        <!-- 版本信息卡片 -->
        <ui:VisualElement class="card">
            <ui:VisualElement class="card-header">
                <ui:Label text="Version Information" class="card-title" />
            </ui:VisualElement>
            <ui:VisualElement class="card-content">
                <ui:VisualElement class="version-container">
                    <ui:Label text="Current Version:" class="version-label" />
                    <ui:TextField name="BuildVersion" readonly="true" class="version-value form-field" />
                    <ui:Toggle label="Auto Increment" name="Toggle" class="toggle-field" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 输出路径卡片 -->
        <ui:VisualElement class="card">
            <ui:VisualElement class="card-header">
                <ui:Label text="Output Paths" class="card-title" />
            </ui:VisualElement>
            <ui:VisualElement class="card-content">
                <!-- Asset 输出路径 -->
                <ui:VisualElement name="AssetOutputPar" class="form-row">
                    <ui:TextField label="Asset Output" name="BuildOutput" readonly="true" class="form-field" />
                    <ui:Button text="Browse" name="BrowseButton" class="browse-button" />
                </ui:VisualElement>

                <!-- Script 输出路径 -->
                <ui:VisualElement name="ScriptOutputPar" class="form-row hidden">
                    <ui:TextField label="Script Output" name="BuildOutput" readonly="true" class="form-field" />
                    <ui:Button text="Browse" name="BrowseButton" class="browse-button" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 构建选项卡片 -->
        <ui:VisualElement class="card">
            <ui:VisualElement class="card-header">
                <ui:Label text="Build Options" class="card-title" />
            </ui:VisualElement>
            <ui:VisualElement class="card-content">
                <uie:EnumField label="Build Mode" name="HybridBuildOption" class="enum-field" />
                <ui:VisualElement class="separator" />
                <ui:Toggle label="Clear Build Cache" name="ClearBuildCache" class="toggle-field" />
                <ui:Toggle label="Use Asset Dependency DB" name="UseAssetDependency" class="toggle-field" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- DLL 配置卡片 -->
        <ui:VisualElement class="card">
            <ui:VisualElement class="card-header">
                <ui:Label text="DLL Configuration" class="card-title" />
            </ui:VisualElement>
            <ui:VisualElement class="card-content">
                <uie:ObjectField label="Patched AOT DLL Folder" name="PatchedAOTDLLFolder" type="UnityEditor.DefaultAsset, UnityEditor.CoreModule" class="object-field" />
                <uie:ObjectField label="Hot Update DLL Folder" name="HotUpdateDLLFolder" type="UnityEditor.DefaultAsset, UnityEditor.CoreModule" class="object-field" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 资源包配置卡片 -->
        <ui:VisualElement class="card">
            <ui:VisualElement class="card-header">
                <ui:Label text="Asset Bundle Configuration" class="card-title" />
            </ui:VisualElement>
            <ui:VisualElement class="card-content">
                <ui:Label name="PackageErrorLabel" text="More than 2 packages are required to execute HybridBuild!" class="warning-label hidden" />
                <ui:VisualElement name="AssetBundlePackageContainer" class="package-list" />
                <ui:VisualElement class="separator" />
                <ui:VisualElement name="EncryptionContainer" />
                <uie:EnumField label="Compression" name="Compression" class="enum-field" />
                <uie:EnumField label="File Name Style" name="FileNameStyle" class="enum-field" />
                <uie:EnumField label="Copy Buildin File Option" name="CopyBuildinFileOption" class="enum-field" />
                <ui:TextField label="Copy Buildin File Param" name="CopyBuildinFileParam" class="form-field" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 热更新脚本容器（可选显示） -->
        <ui:VisualElement name="HotUpdateScriptContainer" class="card hidden">
            <ui:VisualElement class="card-header">
                <ui:Label text="Hot Update Script" class="card-title" />
            </ui:VisualElement>
            <ui:VisualElement class="card-content">
                <ui:VisualElement name="VersionPar" class="version-container">
                    <ui:Label text="Script Version:" class="version-label" />
                    <ui:TextField name="BuildVersion" readonly="true" class="version-value form-field" />
                    <ui:Toggle label="Auto Increment" name="Toggle" class="toggle-field" />
                </ui:VisualElement>
                <ui:Toggle label="Build Hot Update Script" name="BuildHotUpdateScriptToggle" class="toggle-field" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 扩展容器 -->
        <ui:VisualElement name="ExtensionContainer" />

        <!-- 构建按钮 -->
        <ui:Button text="Start Build" name="Build" class="button-primary button-success" />
    </ui:VisualElement>
</ui:UXML>
